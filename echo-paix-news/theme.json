{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "ink",
          "name": "Encre",
          "color": "#142b3b"
        },
        {
          "slug": "paper",
          "name": "Papier",
          "color": "#fbfaf7"
        },
        {
          "slug": "muted",
          "name": "Gris clair",
          "color": "#eeede8"
        },
        {
          "slug": "red",
          "name": "Rouge actualité",
          "color": "#ad2838"
        },
        {
          "slug": "blue",
          "name": "Bleu paix",
          "color": "#145373"
        },
        {
          "slug": "subtle",
          "name": "Texte secondaire",
          "color": "#53616b"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "editorial",
          "name": "Newsreader",
          "fontFamily": "Newsreader, Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Newsreader",
              "fontStyle": "normal",
              "fontWeight": "200 800",
              "src": ["file:./assets/fonts/newsreader.ttf"]
            }
          ]
        },
        {
          "slug": "sans",
          "name": "Manrope",
          "fontFamily": "Manrope, Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Manrope",
              "fontStyle": "normal",
              "fontWeight": "200 800",
              "src": ["file:./assets/fonts/manrope.ttf"]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Petit",
          "size": "0.875rem"
        },
        {
          "slug": "medium",
          "name": "Courant",
          "size": "1rem"
        },
        {
          "slug": "large",
          "name": "Intertitre",
          "size": "1.75rem"
        },
        {
          "slug": "x-large",
          "name": "Titre",
          "size": "2.75rem"
        },
        {
          "slug": "xx-large",
          "name": "Grand titre",
          "size": "4rem"
        }
      ]
    },
    "spacing": {
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        {
          "slug": "20",
          "name": "Très petit",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "Petit",
          "size": "1rem"
        },
        {
          "slug": "40",
          "name": "Moyen",
          "size": "1.5rem"
        },
        {
          "slug": "50",
          "name": "Grand",
          "size": "2rem"
        },
        {
          "slug": "60",
          "name": "Section",
          "size": "3rem"
        },
        {
          "slug": "70",
          "name": "Très grand",
          "size": "4.5rem"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "1rem",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "clamp(20px, 4vw, 64px)",
        "right": "clamp(20px, 4vw, 64px)"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|editorial",
          "fontWeight": "500",
          "lineHeight": "1.08"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|blue"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|red"
          }
        }
      }
    },
    "blocks": {
      "core/post-title": {
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ink"
            }
          }
        }
      },
      "core/button": {
        "color": {
          "background": "var:preset|color|blue",
          "text": "var:preset|color|paper"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "En-tête",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Pied de page",
      "area": "footer"
    }
  ]
}
